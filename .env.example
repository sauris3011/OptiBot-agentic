# OptiBot configuration. Copy to .env and fill in.
# Validated at boot by backend/app/config/settings.py (FR-7.3).

# --- LLM Gateway (required) ---------------------------------------------
LITELLM_GATEWAY_URL=
LITELLM_API_KEY=

# --- Ports (must all be > 1024, NFR-1.3) --------------------------------
BACKEND_PORT=8787
FRONTEND_PORT=3939
WIREMOCK_PORT=8181

# --- TLS ----------------------------------------------------------------
# Preferred path: point REQUESTS_CA_BUNDLE at the corporate CA bundle and
# leave SSL_VERIFY=true. Startup tries the bundle BEFORE any bypass (NFR-2.2).
#
# SSL_VERIFY=false disables certificate verification entirely. That removes
# MITM protection wholesale - it cannot distinguish the sanctioned corporate
# proxy from any other interceptor. Acceptable for this synthetic-data
# prototype only; never for real credentials or personal data (NFR-2.5).
SSL_VERIFY=true
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# --- Storage (embedded, file-based, NFR-1.4) ----------------------------
DATA_DIR=./data

# --- Embeddings (local, in-process) -------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_HOME=

# --- Observability ------------------------------------------------------
# SQLite is authoritative. This mirror is optional and off by default;
# its failure degrades observability without breaking the system (NFR-3.2).
TELEMETRY_MIRROR_ENABLED=false
TELEMETRY_MIRROR_PROVIDER=langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Resiliency ---------------------------------------------------------
# Hard ceiling on tokens per process lifetime; prevents retry storms from
# silently consuming spend (FR-7.4). Blank = no cap.
TOKEN_BUDGET_CAP=2000000
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=0.5

# --- Mock enterprise APIs -----------------------------------------------
WIREMOCK_BASE_URL=http://127.0.0.1:8181

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
